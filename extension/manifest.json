{
  "manifest_version": 3,
  "name": "dashhound",
  "version": "0.5.1",
  "description": "A dashcam for your dev browser: a local log of what you did, for you and your coding agent.",
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "redact.js",
      "dog.js",
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "dashhound",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/dapple/icon-16.png",
      "32": "icons/dapple/icon-32.png",
      "48": "icons/dapple/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/dapple/icon-16.png",
    "32": "icons/dapple/icon-32.png",
    "48": "icons/dapple/icon-48.png",
    "96": "icons/dapple/icon-96.png",
    "128": "icons/dapple/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dashhound@dashhound",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
