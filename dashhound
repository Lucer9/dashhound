#!/usr/bin/env python3
"""dashhound: a dashcam for your dev browser.

The browser extension records what you do on the sites you choose (pages, clicks, field changes, API calls,
errors, and a screenshot when something worth seeing happens). This one file is everything else:

  dashhound log [--since 30m] [--grep text] [--kind click,net]   read the timeline
  dashhound shots [--since 1h]                                     list screenshots
  dashhound clear [--since 10m] [--yes]                            delete recordings (all, or only the last N minutes)
  dashhound status                                                 folder, size, newest event, is a browser connected
  dashhound mcp                                                    MCP server (stdio) so coding agents can read it
  dashhound install [--chrome-id ID]                               register the native host with Firefox / Chrome
  dashhound pack                                                   zip the extension for Firefox (dist/dashhound.xpi)
  dashhound selftest                                               check writer, reader and MCP server

When a browser starts it (native messaging), it is the host: it appends events to one JSON Lines file per hour
under the data directory and deletes anything older than the configured hours. Nothing leaves the machine.
"""
import argparse
import base64
import html
import json
import os
import shlex
import struct
import subprocess
import sys
import tempfile
import time
import zipfile

VERSION = "0.4.0"
EXT_ID = "dashhound@dashhound"
HERE = os.path.dirname(os.path.realpath(__file__))
DATA = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "dashhound")
CONFIG = "config.json"
SHARED = os.path.join(sys.prefix, "share", "dashhound")  # where pip puts the extension when installed without a clone
UNITS = {"s": 1, "m": 60, "h": 3600, "d": 86400}


def shots_dir():
    return os.path.join(DATA, "shots")


def write(msg, state):
    """Host side: stores one message from the extension (event, screenshot or config) and prunes old files."""
    if "config" in msg:
        state["keep_hours"] = max(1, int(msg["config"].get("keepHours") or 24))
        state["max_mb"] = max(10, int(msg["config"].get("maxMB") or 500))
        os.makedirs(DATA, exist_ok=True)
        with open(os.path.join(DATA, CONFIG), "w") as f:
            json.dump({"keepHours": state["keep_hours"], "maxMB": state["max_mb"]}, f)
        return
    os.makedirs(shots_dir(), exist_ok=True)
    ev = msg.get("event")
    if "shot" in msg:
        s = msg["shot"]
        name = time.strftime("%Y%m%d-%H%M%S", time.localtime(s["ts"] / 1000)) + f"-{s['tab']}.jpg"
        path = os.path.join(shots_dir(), name)
        with open(path, "wb") as f:
            f.write(base64.b64decode(s["dataUrl"].split(",", 1)[1]))
        ev = {k: v for k, v in s.items() if k != "dataUrl"}
        ev.update(kind="shot", file=path)
    if not ev:
        return
    with open(os.path.join(DATA, time.strftime("%Y-%m-%d-%H") + ".jsonl"), "a") as f:
        f.write(json.dumps(ev) + "\n")
    state["writes"] = state.get("writes", 0) + 1
    if state["writes"] % 200 == 0 or time.time() - state.get("pruned", 0) > 600:
        state["pruned"] = time.time()
        prune(state.get("keep_hours", 24), state.get("max_mb", 500))


def prune(keep_hours, max_mb=500):
    """Loop recording: drops files older than keep_hours, then the oldest files until the total fits max_mb."""
    files = []
    for d in (DATA, shots_dir()):
        if os.path.isdir(d):
            files += [os.path.join(d, n) for n in os.listdir(d) if n != CONFIG and os.path.isfile(os.path.join(d, n))]
    files.sort(key=os.path.getmtime)
    cutoff = time.time() - keep_hours * 3600
    total = sum(os.path.getsize(f) for f in files)
    for f in files:
        if os.path.getmtime(f) >= cutoff and total <= max_mb * 1024 * 1024:
            break
        total -= os.path.getsize(f)
        os.unlink(f)


def clear(since=None):
    """Deletes recordings: everything, or only events and screenshots from the last `since`. Returns (events, shots) removed."""
    start = since_ts(since) if since else 0
    gone = shots = 0
    if os.path.isdir(shots_dir()):
        for n in os.listdir(shots_dir()):
            full = os.path.join(shots_dir(), n)
            if os.path.isfile(full) and os.path.getmtime(full) >= start:
                os.unlink(full)
                shots += 1
    if os.path.isdir(DATA):
        for n in sorted(os.listdir(DATA)):
            full = os.path.join(DATA, n)
            if not n.endswith(".jsonl") or os.path.getmtime(full) < start:
                continue
            keep = []
            with open(full) as f:
                for line in f:
                    try:
                        drop = json.loads(line).get("ts", 0) / 1000 >= start
                    except ValueError:
                        drop = False
                    if drop:
                        gone += 1
                    else:
                        keep.append(line)
            if not keep:
                os.unlink(full)
            else:
                tmp = full + ".tmp"
                with open(tmp, "w") as f:
                    f.writelines(keep)
                os.replace(tmp, full)
    return gone, shots


def host_running():
    """True/False when a dashhound host process is running (a browser started it), None if processes cannot be listed."""
    try:
        out = subprocess.run(["ps", "-A", "-o", "args="], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    return any("dashhound" in line and (EXT_ID in line or "chrome-extension://" in line) for line in out.splitlines())


def status_text(running=None):
    """Data folder, size against the cap, oldest and newest event, last hour's counts, and whether a host is connected."""
    used = sum(os.path.getsize(os.path.join(d, n)) for d in (DATA, shots_dir()) if os.path.isdir(d)
               for n in os.listdir(d) if os.path.isfile(os.path.join(d, n)))
    try:
        with open(os.path.join(DATA, CONFIG)) as f:
            cap = json.load(f)["maxMB"]
    except (OSError, ValueError, KeyError):
        cap = None
    allev = events("36500d")
    last = events("1h")
    fmt = lambda e: time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(e["ts"] / 1000))
    link = {True: "connected (host running)", False: "not connected (no host running)", None: "unknown (cannot list processes)"}
    return "\n".join([
        f"data folder: {DATA}",
        f"size:        {used / 1048576:.1f} MB of {cap or 500} MB" + ("" if cap else " (default; the extension has not sent its settings yet)"),
        f"oldest:      {fmt(allev[0]) if allev else 'no events'}",
        f"newest:      {fmt(allev[-1]) if allev else 'no events'}",
        f"last hour:   {len(last)} events, {sum(e.get('kind') == 'shot' for e in last)} screenshots",
        f"browser:     {link[running]}",
    ])


def host():
    """Native messaging loop: length-prefixed JSON on stdin until the browser closes the pipe."""
    state = {}
    while True:
        head = sys.stdin.buffer.read(4)
        if len(head) < 4:
            return
        msg = json.loads(sys.stdin.buffer.read(struct.unpack("@I", head)[0]))
        try:
            write(msg, state)
        except (OSError, ValueError, KeyError):
            pass


def since_ts(text):
    """'90s', '30m', '2h', '1d' -> epoch seconds that long ago."""
    text = text.strip()
    n, unit = (text[:-1], text[-1]) if text[-1] in UNITS else (text, "m")
    return time.time() - float(n) * UNITS[unit]


def events(since="1h", grep=None, kinds=None):
    """Events newer than `since`, oldest first, optionally filtered by kind and by text in their line."""
    start = since_ts(since)
    out = []
    if not os.path.isdir(DATA):
        return out
    for name in sorted(os.listdir(DATA)):
        full = os.path.join(DATA, name)
        if not name.endswith(".jsonl") or os.path.getmtime(full) < start:
            continue
        with open(full) as f:
            for line in f:
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                if e.get("ts", 0) / 1000 >= start and (not kinds or e.get("kind") in kinds):
                    out.append(e)
    out.sort(key=lambda e: e["ts"])
    return [e for e in out if not grep or grep.lower() in (line_of(e) + str(e.get("req") or "") + str(e.get("res") or "")).lower()]


def size(text):
    n = len(text or "")
    return f"{n}B" if n < 1024 else f"{n / 1024:.1f}KB"


def with_bodies(e, limit=None):
    """A net event's line plus its request and response bodies, indented."""
    out = line_of(e)
    for key, label in (("req", "sent"), ("res", "got ")):
        body = e.get(key)
        if body:
            body = body if limit is None or len(body) <= limit else body[:limit] + f"…[{len(body) - limit} more chars]"
            out += f"\n    {label} {body}"
    return out


def line_of(e):
    """One event as a line a person (or an agent) can read."""
    k = e.get("kind")
    if k == "page":
        what = f"{e.get('url')}  {e.get('title') or ''}".rstrip()
    elif k == "click":
        what = f"{e.get('text')!r}" + (f" ({e['tag']})" if e.get("tag") else "") + f" on {e.get('path')}"
    elif k == "field":
        what = f"{e.get('name')} = {e.get('value')!r} on {e.get('path')}"
    elif k == "submit":
        what = f"form {e.get('text')} on {e.get('path')}"
    elif k == "net":
        sizes = " ".join(f"{label} {size(e[key])}" for key, label in (("req", "sent"), ("res", "got")) if e.get(key))
        what = f"{e.get('method')} {e.get('status') or e.get('error')} {e.get('url')}" + (f"  ({sizes})" if sizes else "")
    elif k == "console":
        what = f"{e.get('level')}: {e.get('text')}"
    elif k == "shot":
        what = f"{e.get('reason')} -> {e.get('file')}"
    else:
        what = json.dumps(e)
    return f"{time.strftime('%H:%M:%S', time.localtime(e['ts'] / 1000))} tab {e.get('tab')} {k:<7} {what}"


def timeline(since="30m", grep=None, kinds=None, limit=400, bodies=False, body_limit=2000):
    lines = [with_bodies(e, body_limit) if bodies else line_of(e) for e in events(since, grep, kinds)]
    if len(lines) > limit:
        lines = [f"... {len(lines) - limit} earlier events not shown"] + lines[-limit:]
    return "\n".join(lines) or f"nothing recorded in the last {since}"


REPORT_CSS = ("body{font:14px/1.4 system-ui,sans-serif;margin:2em;max-width:70em}"
              "li{list-style:none;margin:.3em 0}code{font:13px monospace}.bad{color:#b00020}"
              "details{margin:.2em 0 .2em 2em}pre{white-space:pre-wrap;word-break:break-all;background:#f4f4f4;padding:.5em}"
              "img{max-width:100%;border:1px solid #ccc;margin:.3em 0 .3em 2em;display:block}")


def shot_uri(path):
    """A recorded screenshot as a data: URI, or None if it is gone or is not inside the screenshots folder."""
    real = os.path.realpath(path or "")
    if not real.startswith(os.path.realpath(shots_dir()) + os.sep) or not os.path.isfile(real):
        return None
    with open(real, "rb") as f:
        return "data:image/jpeg;base64," + base64.b64encode(f.read()).decode()


def report(since="30m", grep=None, kinds=None):
    """One self-contained HTML page of the timeline: screenshots inline, API bodies collapsible. Every value is escaped."""
    esc = html.escape
    items = []
    for e in events(since, grep, kinds):
        k = e.get("kind")
        bad = k == "console" or (k == "net" and (e.get("error") or (e.get("status") or 0) >= 400))
        item = f'<li><code class="bad">{esc(line_of(e))}</code>' if bad else f"<li><code>{esc(line_of(e))}</code>"
        if k == "net":
            for key, label in (("req", "sent"), ("res", "got")):
                if e.get(key):
                    item += f"<details><summary>{label} {esc(size(e[key]))}</summary><pre>{esc(str(e[key]))}</pre></details>"
        if k == "shot":
            uri = shot_uri(e.get("file"))
            item += f'<img alt="{esc(str(e.get("reason")))}" src="{uri}">' if uri else "<details><summary>screenshot no longer on disk</summary></details>"
        items.append(item + "</li>")
    title = f"dashhound: last {since}" + (f", matching {grep}" if grep else "")
    return (f'<!doctype html><meta charset="utf-8"><title>{esc(title)}</title><style>{REPORT_CSS}</style>'
            f"<h1>{esc(title)}</h1><p>{len(items)} events, made {esc(time.strftime('%Y-%m-%d %H:%M:%S'))}</p>"
            f'<ul style="padding:0">{"".join(items) or "<li>nothing recorded</li>"}</ul>')


def write_report(path, since, grep=None, kinds=None):
    """Writes report() to `path` and returns the path."""
    with open(path, "w", encoding="utf-8") as f:
        f.write(report(since, grep, kinds))
    return path


TOOLS = [
    {
        "name": "recent_activity",
        "description": "What the user did in their browser recently, oldest first: pages opened, clicks (by the words "
                       "on the button/link), field changes (name = value; private fields hidden), API calls with "
                       "status and, on request, their bodies, console errors, and screenshots taken at key moments. "
                       "Use it before asking the user what they did or what went wrong.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "since": {"type": "string", "description": "How far back: 90s, 30m, 2h, 1d. Default 30m."},
                "grep": {"type": "string", "description": "Only lines containing this text (case-insensitive)."},
                "kinds": {"type": "array", "items": {"type": "string", "enum": ["page", "click", "field", "submit", "net", "console", "shot"]},
                          "description": "Only these kinds of events."},
                "bodies": {"type": "boolean", "description": "Include what each API call sent and got back (secrets already hidden, cut to 2000 chars). Useful with grep or kinds=['net']."},
            },
        },
    },
    {
        "name": "get_screenshot",
        "description": "A screenshot dashhound took (the path comes from a 'shot' line in recent_activity).",
        "inputSchema": {"type": "object", "properties": {"file": {"type": "string"}}, "required": ["file"]},
    },
]


def call_tool(name, args):
    """Runs one MCP tool; returns MCP content items."""
    if name == "recent_activity":
        return [{"type": "text", "text": timeline(args.get("since") or "30m", args.get("grep"), args.get("kinds"), bodies=bool(args.get("bodies")))}]
    if name == "get_screenshot":
        path = os.path.realpath(args.get("file", ""))
        if not path.startswith(os.path.realpath(shots_dir()) + os.sep) or not os.path.isfile(path):
            raise ValueError("not a dashhound screenshot")
        with open(path, "rb") as f:
            return [{"type": "image", "data": base64.b64encode(f.read()).decode(), "mimeType": "image/jpeg"}]
    raise ValueError(f"unknown tool {name}")


def mcp_reply(req):
    """Answers one JSON-RPC request from an MCP client; None for notifications."""
    method, rid, params = req.get("method"), req.get("id"), req.get("params") or {}
    if rid is None:
        return None
    if method == "initialize":
        result = {"protocolVersion": params.get("protocolVersion", "2025-06-18"), "capabilities": {"tools": {}},
                  "serverInfo": {"name": "dashhound", "version": VERSION}}
    elif method == "tools/list":
        result = {"tools": TOOLS}
    elif method == "tools/call":
        try:
            result = {"content": call_tool(params.get("name"), params.get("arguments") or {})}
        except (ValueError, OSError) as e:
            result = {"content": [{"type": "text", "text": str(e)}], "isError": True}
    elif method == "ping":
        result = {}
    else:
        return {"jsonrpc": "2.0", "id": rid, "error": {"code": -32601, "message": f"no method {method}"}}
    return {"jsonrpc": "2.0", "id": rid, "result": result}


def mcp():
    """MCP over stdio: one JSON-RPC message per line."""
    for line in sys.stdin:
        if not line.strip():
            continue
        reply = mcp_reply(json.loads(line))
        if reply is not None:
            sys.stdout.write(json.dumps(reply) + "\n")
            sys.stdout.flush()


def extension_dir():
    """The extension folder: next to this file in a clone, under the install prefix when installed with pip/pipx."""
    for base in (HERE, SHARED):
        if os.path.isfile(os.path.join(base, "extension", "manifest.json")):
            return os.path.join(base, "extension")
    return None


def host_wrapper():
    """Writes a small executable that runs this file with the Python it was installed for, and returns its path.
    Browsers need a path they can execute directly; inside a pipx virtualenv `__file__` may not be one."""
    os.makedirs(DATA, exist_ok=True)
    path = os.path.join(DATA, "dashhound-host")
    with open(path, "w") as f:
        f.write("#!/bin/sh\nexec %s %s \"$@\"\n" % (shlex.quote(sys.executable), shlex.quote(os.path.realpath(__file__))))
    os.chmod(path, 0o755)
    return path


def install(chrome_id=None):
    """Registers a wrapper around this script as the `dashhound` native messaging host for Firefox (and Chrome when given its id)."""
    me = host_wrapper()
    mac = sys.platform == "darwin"
    targets = [(os.path.expanduser("~/Library/Application Support/Mozilla/NativeMessagingHosts" if mac else "~/.mozilla/native-messaging-hosts"),
                {"allowed_extensions": [EXT_ID]})]
    if chrome_id:
        targets.append((os.path.expanduser("~/Library/Application Support/Google/Chrome/NativeMessagingHosts" if mac else "~/.config/google-chrome/NativeMessagingHosts"),
                        {"allowed_origins": [f"chrome-extension://{chrome_id}/"]}))
    for folder, allow in targets:
        os.makedirs(folder, exist_ok=True)
        with open(os.path.join(folder, "dashhound.json"), "w") as f:
            json.dump({"name": "dashhound", "description": "dashhound recorder", "path": me, "type": "stdio", **allow}, f, indent=2)
        print(f"registered: {os.path.join(folder, 'dashhound.json')}")


def pack():
    """Zips the extension to dist/dashhound.xpi (next to the clone, or in the current folder when installed)."""
    src = extension_dir()
    if not src:
        sys.exit("dashhound: cannot find the extension folder; run `pack` from a clone of the repository")
    dist = os.path.join(HERE if src == os.path.join(HERE, "extension") else os.getcwd(), "dist")
    os.makedirs(dist, exist_ok=True)
    out = os.path.join(dist, "dashhound.xpi")
    with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
        for name in sorted(os.listdir(src)):
            z.write(os.path.join(src, name), name)
    print(out)


def selftest():
    """Writer -> reader -> MCP round trip in a temp data dir."""
    global DATA
    DATA = tempfile.mkdtemp()
    now = int(time.time() * 1000)
    state = {}
    write({"config": {"keepHours": 2}}, state)
    assert state["keep_hours"] == 2
    write({"event": {"ts": now, "tab": 1, "kind": "click", "text": "Save", "tag": "button", "path": "/a"}}, state)
    write({"event": {"ts": now + 1, "tab": 1, "kind": "field", "name": "Card", "value": "[private]", "path": "/a"}}, state)
    write({"shot": {"ts": now + 2, "tab": 1, "reason": "clicked Save", "url": "u",
                    "dataUrl": "data:image/jpeg;base64," + base64.b64encode(b"jpg").decode()}}, state)
    assert [e["kind"] for e in events("5m")] == ["click", "field", "shot"]
    assert "'Save' (button) on /a" in timeline("5m")
    assert events("5m", grep="card")[0]["kind"] == "field"
    assert events("5m", kinds=["shot"])[0]["file"].endswith(".jpg")
    assert mcp_reply({"method": "notifications/initialized"}) is None
    assert mcp_reply({"id": 1, "method": "initialize", "params": {"protocolVersion": "x"}})["result"]["protocolVersion"] == "x"
    assert [t["name"] for t in mcp_reply({"id": 2, "method": "tools/list"})["result"]["tools"]] == ["recent_activity", "get_screenshot"]
    text = mcp_reply({"id": 3, "method": "tools/call", "params": {"name": "recent_activity", "arguments": {"since": "5m"}}})
    assert "clicked Save" in text["result"]["content"][0]["text"]
    img = mcp_reply({"id": 4, "method": "tools/call", "params": {"name": "get_screenshot", "arguments": {"file": events("5m", kinds=["shot"])[0]["file"]}}})
    assert img["result"]["content"][0]["type"] == "image"
    bad = mcp_reply({"id": 5, "method": "tools/call", "params": {"name": "get_screenshot", "arguments": {"file": "/etc/passwd"}}})
    assert bad["result"]["isError"]
    write({"event": {"ts": now + 3, "tab": 1, "kind": "net", "method": "POST", "url": "http://l/api/promo", "status": 422,
                     "req": '{"code":"SPRING"}', "res": '{"error":"promo expired"}'}}, state)
    assert "(sent 17B got 25B)" in timeline("5m", kinds=["net"])
    assert events("5m", grep="promo expired")[0]["status"] == 422
    assert "got  {\"error\":\"promo expired\"}" in timeline("5m", kinds=["net"], bodies=True)
    withb = mcp_reply({"id": 6, "method": "tools/call", "params": {"name": "recent_activity", "arguments": {"since": "5m", "bodies": True}}})
    assert "promo expired" in withb["result"]["content"][0]["text"]
    write({"event": {"ts": now + 4, "tab": 1, "kind": "console", "level": "error", "text": "<script>alert(1)</script>"}}, state)
    out = os.path.join(DATA, "report.html")
    write_report(out, "5m")
    page = open(out, encoding="utf-8").read()
    assert "&#x27;Save&#x27; (button) on /a" in page and "data:image/jpeg;base64," in page and "promo expired" in page
    assert "<script>alert(1)</script>" not in page and "&lt;script&gt;alert(1)&lt;/script&gt;" in page
    write_report(out, "5m", kinds=["net"])
    assert "Save" not in open(out, encoding="utf-8").read()
    old = os.path.join(DATA, "2000-01-01-00.jsonl")
    open(old, "w").close()
    os.utime(old, (0, 0))
    prune(2)
    assert not os.path.exists(old)
    big = [os.path.join(DATA, f"2099-01-01-0{i}.jsonl") for i in range(3)]
    for i, f in enumerate(big):
        with open(f, "w") as h:
            h.write("x" * 6 * 1024 * 1024)
        os.utime(f, (time.time() - 30 + i, time.time() - 30 + i))
    prune(24, max_mb=10)
    assert [os.path.exists(f) for f in big] == [False, False, True], "size cap drops the oldest first"
    DATA = tempfile.mkdtemp()
    state = {}
    write({"config": {"maxMB": 50}}, state)
    write({"event": {"ts": now - 3 * 3600 * 1000, "tab": 1, "kind": "click", "text": "Old", "tag": "button", "path": "/a"}}, state)
    write({"event": {"ts": now - 60 * 1000, "tab": 1, "kind": "click", "text": "Recent", "tag": "button", "path": "/a"}}, state)
    write({"shot": {"ts": now, "tab": 1, "reason": "r", "url": "u", "dataUrl": "data:image/jpeg;base64," + base64.b64encode(b"jpg").decode()}}, state)
    st = status_text(True)
    assert "of 50 MB" in st and "2 events, 1 screenshots" in st and "connected (host running)" in st, st
    assert "no host running" in status_text(False) and "unknown" in status_text(None)
    assert clear("10m") == (2, 1), "only the last 10 minutes go (the recent click and the shot event)"
    assert [e["text"] for e in events("1d")] == ["Old"] and not os.listdir(shots_dir())
    assert os.path.exists(os.path.join(DATA, CONFIG)), "clear keeps the settings"
    assert clear() == (1, 0) and events("1d") == []
    assert "oldest:      no events" in status_text()
    assert host_running() in (True, False, None)
    wrapper = host_wrapper()
    assert os.access(wrapper, os.X_OK) and sys.executable in open(wrapper).read(), "host wrapper is executable"
    assert extension_dir(), "extension folder found"
    print("selftest ok")


def main():
    if EXT_ID in sys.argv[1:] or any(a.startswith("chrome-extension://") for a in sys.argv[1:]):
        return host()
    p = argparse.ArgumentParser(prog="dashhound", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("log", help="print the timeline")
    s.add_argument("--since", default="1h")
    s.add_argument("--grep")
    s.add_argument("--kind", help="comma-separated: page,click,field,submit,net,console,shot")
    s.add_argument("--json", action="store_true", help="raw events, one JSON object per line")
    s.add_argument("--bodies", action="store_true", help="print what each API call sent and got back under its line")
    s = sub.add_parser("report", help="write a self-contained HTML timeline to attach to a bug report")
    s.add_argument("--since", default="30m")
    s.add_argument("--grep")
    s.add_argument("--kind", help="comma-separated: page,click,field,submit,net,console,shot")
    s.add_argument("-o", "--output", default="dashhound-report.html")
    s = sub.add_parser("shots", help="list screenshots")
    s.add_argument("--since", default="1h")
    s = sub.add_parser("clear", help="delete recordings (all, or only the last N minutes)")
    s.add_argument("--since", help="only delete the last N, e.g. 10m, 2h (default: everything)")
    s.add_argument("--yes", action="store_true", help="do not ask for confirmation")
    sub.add_parser("status", help="data folder, size, newest event, whether a browser is connected")
    sub.add_parser("mcp", help="MCP server on stdio")
    s = sub.add_parser("install", help="register the native host")
    s.add_argument("--chrome-id", help="the extension id Chrome shows after loading it unpacked")
    sub.add_parser("pack", help="build dist/dashhound.xpi")
    sub.add_parser("selftest")
    a = p.parse_args()
    if a.cmd == "log":
        kinds = a.kind.split(",") if a.kind else None
        if a.json:
            for e in events(a.since, a.grep, kinds):
                print(json.dumps(e))
        else:
            print(timeline(a.since, a.grep, kinds, limit=10 ** 9, bodies=a.bodies, body_limit=None))
    elif a.cmd == "report":
        print(os.path.abspath(write_report(a.output, a.since, a.grep, a.kind.split(",") if a.kind else None)))
    elif a.cmd == "shots":
        print(timeline(a.since, kinds=["shot"], limit=10 ** 9))
    elif a.cmd == "clear":
        what = f"the last {a.since}" if a.since else "ALL recordings"
        if not a.yes and input(f"Delete {what} in {DATA}? [y/N] ").strip().lower() not in ("y", "yes"):
            sys.exit("nothing deleted")
        gone, shots = clear(a.since)
        print(f"deleted {gone} events and {shots} screenshots")
    elif a.cmd == "status":
        print(status_text(host_running()))
    elif a.cmd == "mcp":
        mcp()
    elif a.cmd == "install":
        install(a.chrome_id)
    elif a.cmd == "pack":
        pack()
    else:
        selftest()


if __name__ == "__main__":
    main()
